# Database (required)
# Local dev example:
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# For Vercel: use a managed Postgres URL (Neon, Vercel Postgres, Supabase, etc.)
# Example: DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require

# App URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# On Vercel, set to your deployed URL, e.g. https://your-project.vercel.app

# FLOODCAST: no API keys needed (USGS + Open-Meteo are free/keyless and fetched
# in the visitor's browser). SOS/Alerts use DATABASE_URL above — run
# `npm run db:push` once to create fc_* tables. Without a DB they transparently
# fall back to in-memory storage (demo only; resets on redeploy).
